# Copy to frontend/.env.local. NEXT_PUBLIC_* values are baked into the build.

# Base URL of the Django API (as reached from the browser).
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# ISO 4217 currency code and locale used for formatting money and dates.
NEXT_PUBLIC_CURRENCY=USD
NEXT_PUBLIC_LOCALE=en-US

# Language for POS voice search (Chrome/Edge Web Speech API), e.g. en-US, en-GB, ur-PK.
NEXT_PUBLIC_SPEECH_LANG=en-US

# Printed on the receipt header/footer and shown in the sidebar.
NEXT_PUBLIC_PHARMACY_NAME=
NEXT_PUBLIC_PHARMACY_ADDRESS=
NEXT_PUBLIC_PHARMACY_PHONE=
NEXT_PUBLIC_RECEIPT_FOOTER=Thank you for your purchase!
