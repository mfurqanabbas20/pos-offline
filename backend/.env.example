# Copy to backend/.env and adjust. All values are optional; defaults suit local development.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database: "postgres" (default) or "sqlite" for a zero-setup local run.
DB_ENGINE=postgres
# SQLITE_PATH=db.sqlite3          # only used when DB_ENGINE=sqlite
POSTGRES_DB=pharmacy_pos
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Comma-separated list of frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Local timezone of the pharmacy; controls "today", expiry checks and daily dashboard buckets.
TIME_ZONE=UTC

# Batches expiring within this many days are flagged as "expiring soon".
EXPIRY_WARNING_DAYS=60

JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Name printed on downloadable reports.
PHARMACY_NAME=Tasnim Pharmacy
